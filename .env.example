# Supernote Cloud credentials, used by `xiehanzi push`.
# Copy to .env and fill in. .env is gitignored and never read by anything else.
SUPERNOTE_EMAIL=
SUPERNOTE_PASSWORD=

# OpenCode Go API key for recall grading's vision partner. Optional: without it the key
# opencode stored in ~/.local/share/opencode/auth.json is used, and without either,
# grading uses Google alone.
XIEHANZI_OPENCODE_GO_KEY=

# Anki backup that `xiehanzi learn` runs before any write. Optional.
# URL to POST to; unset means the default, http://127.0.0.1:18766/backup.
# XIEHANZI_ANKI_BACKUP_URL=
# Set to off to write without a backup service (a warning is printed each time).
# XIEHANZI_ANKI_BACKUP=off
