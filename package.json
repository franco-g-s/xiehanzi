{
  "name": "xiehanzi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Chinese handwriting practice sheet (字帖) generator for the Supernote",
  "bin": {
    "xiehanzi": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval:recognition": "tsx scripts/eval-recognition.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "supernote-typescript": "^0.7.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "hanzi-writer-data": "^2.0.1",
    "image-js": "^1.7.0",
    "playwright": "^1.62.1",
    "skia-canvas": "^3.0.8"
  }
}
